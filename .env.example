FLASK_APP=run.py
FLASK_DEBUG=1
SECRET_KEY=change-me-in-production
DATABASE_URL=sqlite:///instance/vokter.db
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8082
CORS_SUPPORTS_CREDENTIALS=false
CORS_MAX_AGE=600
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Groq (free tier: 14 400 req/day) — get key at https://console.groq.com
# Used as fallback when Gemini quota is exhausted.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
