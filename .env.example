FLASK_APP=run.py
FLASK_DEBUG=1
SECRET_KEY=change-me-in-production
DATABASE_URL=sqlite:///instance/vokter.db
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_URL=http://localhost:5173/reset-password
PASSWORD_RESET_TTL_SECONDS=1800
PASSWORD_RESET_RATE_LIMIT=5 per hour
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8082
CORS_SUPPORTS_CREDENTIALS=false
CORS_MAX_AGE=600
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Groq (free tier: 14 400 req/day) — get key at https://console.groq.com
# Used as the primary low-latency provider when configured.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Maximum wait per external provider before using the next provider/fallback.
AI_PROVIDER_TIMEOUT_SECONDS=10

# SMTP para recuperación de contraseña
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@example.com
